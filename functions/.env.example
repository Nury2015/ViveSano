# Copia este archivo como functions/.env y completa los valores.
# (Las claves secretas NO van aquí: se guardan con `firebase functions:secrets:set`)

# Modelo de Gemini. "gemini-flash-latest" se actualiza solo cuando Google retira versiones.
GEMINI_MODEL=gemini-flash-latest

# ID del precio de Stripe para Premium (empieza con price_). Debe coincidir con suscripcion.html
STRIPE_PRICE_ID=
